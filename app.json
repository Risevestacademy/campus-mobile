{
  "expo": {
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "campusmobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3155D6",
        "foregroundImage": "./src/assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf",
            "node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
            "node_modules/@expo-google-fonts/bricolage-grotesque/600SemiBold/BricolageGrotesque_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/instrument-sans/400Regular/InstrumentSans_400Regular.ttf",
            "node_modules/@expo-google-fonts/instrument-sans/500Medium/InstrumentSans_500Medium.ttf",
            "node_modules/@expo-google-fonts/instrument-sans/600SemiBold/InstrumentSans_600SemiBold.ttf"
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "image": "./src/assets/images/splash.png",
          "backgroundColor": "#3155D6",
          "imageWidth": 642
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.416818957033-okf2o1q2975tmf0f7i8mae30tab2k1k8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appConfig": {
        "env": "production",
        "apiBaseUrl": "https://your-api.up.railway.app"
      },
      "router": {},
      "eas": {
        "projectId": "c3d3d2d2-2120-4b08-9d45-a6f09f882500"
      }
    },
    "owner": "rise-academy",
    "updates": {
      "url": "https://u.expo.dev/c3d3d2d2-2120-4b08-9d45-a6f09f882500"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
