import { mkdir, readFile, writeFile } from "node:fs/promises";
import path from "node:path";

import { compile, type JSONSchema } from "json-schema-to-typescript";

const INVALID_SOURCE_MESSAGE =
  "WORLD_SCHEMA_SOURCE must be an HTTPS URL or a path to a JSON schema file.";
const OUTPUT_DIR = path.resolve(process.cwd(), "src/shared/lib/generated");
const OUTPUT_FILE = path.join(OUTPUT_DIR, "world-protocol.d.ts");
const BANNER = `/**
 * Generated by scripts/generate-ws-types.mts from world's JSON schema
 * (apps/world/src/socket/protocol.ts). Do not edit by hand; run
 * \`pnpm ws:type-gen\` instead.
 */`;

/** An HTTPS URL is fetched; anything else is read as a local file. */
async function loadSchema(source: string): Promise<JSONSchema> {
  let url: URL | null = null;
  try {
    url = new URL(source);
  } catch {
    // Not a URL: treat as a file path.
  }

  if (url) {
    if (url.protocol !== "https:") throw new Error(INVALID_SOURCE_MESSAGE);
    const response = await fetch(url);
    if (!response.ok) {
      throw new Error(`Fetching ${url.href} failed: ${response.status}`);
    }
    return (await response.json()) as JSONSchema;
  }

  const file = path.resolve(process.cwd(), source);
  return JSON.parse(await readFile(file, "utf8")) as JSONSchema;
}

async function main(): Promise<void> {
  const source = process.env.WORLD_SCHEMA_SOURCE?.trim();
  if (!source) throw new Error("WORLD_SCHEMA_SOURCE is required.");

  const schema = await loadSchema(source);
  const types = await compile(schema, "WorldProtocol", {
    bannerComment: BANNER,
    additionalProperties: false,
    // Emit every definition, not only those the root catalogue references.
    unreachableDefinitions: true,
    format: false,
  });

  await mkdir(OUTPUT_DIR, { recursive: true });
  await writeFile(OUTPUT_FILE, types);

  // eslint-disable-next-line no-console
  console.log(
    `Generated src/shared/lib/generated/world-protocol.d.ts from ${source}`,
  );
}

main().catch((error: unknown) => {
  console.error(error instanceof Error ? error.message : error);
  process.exit(1);
});
