{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["jest"],
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@core/*": ["./src/core/*"],
      "@design-system/*": ["./src/design-system/*"],
      "@features/*": ["./src/feature/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["scripts/**"]
}
