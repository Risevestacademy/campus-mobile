{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@core/*": ["./src/core/*"],
      "@services/*": ["./src/services/*"],
      "@shared/*": ["./src/shared/*"],
      "@features/*": ["./src/features/*"],
    },
  },
  "include": ["**/*.ts", "**/*.tsx"],
}
